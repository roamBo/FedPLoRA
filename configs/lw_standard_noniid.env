# LW 轻量标准 SFT — Alpaca Dirichlet non-IID (alpha=0.5) + SmolLM2-135M
# 用法: set -a && source configs/lw_standard_noniid.env && set +a
#
# 前置:
#   bash scripts/DataProcessScripts/build_alpaca_lw_standard_noniid_benchmark.sh
#   bash scripts/RunScripts/LWv4/download_lw_model_modelscope.sh

MODEL_PATH=/data/yaominghao/gb/models/SmolLM2-135M
MODELSCOPE_ID=HuggingFaceTB/SmolLM2-135M
BENCHMARK_DIR=data/standard_benchmark_alpaca_LW_noniid_a0.5/seed_42
DIRICHLET_ALPHA=0.5
NUM_CLIENTS=7

CUDA_DEVICES=0
ROUNDS=1
LOCAL_EPOCHS=1
LR=2e-4
LORA_R=8
LORA_ALPHA=16
LORA_DROPOUT=0.05
BATCH_SIZE=2
MAX_SEQ_LENGTH=256
GRADIENT_CHECKPOINTING=1
TORCH_DTYPE=bfloat16
TARGET_MODULES=q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj
TRUST_REMOTE_CODE=0

CLIENT_STATE_DIR=artifacts_LW_standard/v4_client_states
# v2/v4（fed_train_sft_v4.py）
METRICS_OUTPUT_DIR=artifacts_LW_standard/v4_sft_metrics
# 对比 baseline（fed_train_standard_sft.py）
METRICS_BASELINE_OUTPUT_DIR=artifacts_LW_standard/sft_metrics
LOG_DIR=log_LW_standard
LOG_FILENAME_PREFIX=LW_standard_v4
TRAINED_MODELS_ROOT=../trained_models_LW_standard
V4_MIX_SAVE_ROOT=artifacts_LW_standard/v4_mix_a_local
EVAL_MAX_BATCHES=10
EVAL_SEEDS=42
SEED=42

ONESHOT_ANCHOR_LAMBDA=1e-4
ONESHOT_PROX_LAMBDA=0.0
ONESHOT_CONSENSUS_POWER=2.0
ONESHOT_IMPORTANCE_POWER=1.0
ONESHOT_IMPORTANCE_CLIP=5.0
ONESHOT_CONFLICT_THRESHOLD=0.35
ONESHOT_CONFLICT_BLEND=1.0
ONESHOT_SCALE_CLIP_RATIO=0.0

YOCO_SPARSE_LAMBDA=1e-4
YOCO_PCWA_COMPONENTS=3
FEDDAT_TEACHER_LAMBDA=0.01
