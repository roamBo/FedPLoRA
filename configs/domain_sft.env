# 7 域联邦 SFT 主实验默认环境：本地基座 MODEL_PATH（如 Meta-Llama）、benchmark、LoRA 等。
# §11.1 手敲命令前在仓库根目录执行：set -a && source configs/domain_sft.env && set +a
# 批量脚本 run_domain_sft_baselines*.sh / run_exp_*.sh 会自动 source 本文件（若存在）。
#
# 离线 / 禁 Hugging Face Hub：`MODEL_PATH` 必须为已下载完整的本地目录（含 tokenizer、config、权重）。
# 勿使用 `org/name` 形式模型 ID，否则会尝试联网。可选彻底关闭 Hub（失败即报错，不静默下载）：
#   HF_HUB_OFFLINE=1
#   TRANSFORMERS_OFFLINE=1
TOKENIZERS_PARALLELISM=false
MODEL_PATH=/data/yaominghao/gb/models/Meta-Llama-3.1-8B
# 终版主实验默认 35 客户端（7 域 × 每域 5 客户端）
BENCHMARK_DIR=data/domain_benchmark_35c/seed_42
# 加快 eval；写主表前可改为 0 或 unset 表示全量测评
EVAL_MAX_BATCHES=50
ROUNDS=10
LOCAL_EPOCHS=1
LR=2e-4
LORA_R=8
LORA_ALPHA=16
LORA_DROPOUT=0.05
BATCH_SIZE=2
MAX_SEQ_LENGTH=2048
TORCH_DTYPE=bfloat16
TARGET_MODULES=q_proj,k_proj,v_proj,o_proj,up_proj,down_proj,gate_proj
CLIENT_STATE_DIR=artifacts/domain_client_states
TRUST_REMOTE_CODE=0
YOCO_SPARSE_LAMBDA=1e-4
YOCO_PCWA_COMPONENTS=3
ONESHOT_ANCHOR_LAMBDA=1e-4
ONESHOT_PROX_LAMBDA=0.0
ONESHOT_CONSENSUS_POWER=2.0
ONESHOT_IMPORTANCE_POWER=1.0
ONESHOT_IMPORTANCE_CLIP=5.0
ONESHOT_CONFLICT_THRESHOLD=0.35
ONESHOT_CONFLICT_BLEND=1.0
ONESHOT_SCALE_CLIP_RATIO=0.0
ONESHOT_NO_KEEP_INIT_ON_CONFLICT=0
ONESHOT_ORTHOGONALIZE=0

# 全量训练默认加速（run_domain_sft_batch_group*.sh / _fed_train_speed.inc.sh）：
DATALOADER_NUM_WORKERS=6
# 仅评估 DataLoader worker 数（与训练分离；代码在 eval_max_batches 提前结束时显式关闭 worker，避免 Errno 24）
EVAL_DATALOADER_NUM_WORKERS=2
DATALOADER_PERSISTENT_WORKERS=1
ATTN_IMPLEMENTATION=sdpa
# 默认：训练 bundle 由 Python 自动写入仓库同级 ../trained_models/<stem>/（无时间戳；成功有 checkpoint_ok.json，失败为 *_failed/）。
# 覆盖目录：export TRAINED_MODELS_ROOT=/你的绝对路径
TRAINED_MODELS_ROOT=
# 兼容旧脚本名（批量入口已改为仅用 TRAINED_MODELS_ROOT；保留变量以免外部 export 报错）
SAVE_RUN_CHECKPOINT_ROOT=
SEED=42
# EVAL_MAX_BATCHES：只限制「每轮末尾 domain-macro eval」每个 (域×客户端) 的前向 batch 数，
# 不参与 tqdm 里的本地训练步数。训练步数 ≈ ceil(该客户端 train 样本数 / BATCH_SIZE) × LOCAL_EPOCHS，
# 或由 TRAIN_MAX_STEPS_PER_CLIENT 截断（见下）。
# TOKENIZER_USE_FAST=0 时等价 --no-tokenizer-use-fast
#
# 墙钟粗算：单客户端训练时间 ≈ (上述步数) × (每 step 秒数)。例如 360 step × 14s/step ≈ 84min/客户端。
# 若过去约 13min/客户端而现在 ~80min，常见原因是此前开过步数/样本上限，或 GPU 不同。
# 调试用（显著缩短训练，不等价终版主实验）：
#   TRAIN_MAX_STEPS_PER_CLIENT=80
#   # 或 MAX_TRAIN_SAMPLES_PER_CLIENT=500
# 终版主实验勿设上述两项。提速且不砍步数：显存够时可 GRADIENT_CHECKPOINTING=0；或 BATCH_SIZE 加大、
# MAX_SEQ_LENGTH 降低；已装 flash-attn 时可 ATTN_IMPLEMENTATION=flash_attention_2（视模型支持）。
GRADIENT_CHECKPOINTING=1
