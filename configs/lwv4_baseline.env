# FedPLoRA v4 轻量级实验 (LW) — SmolLM2-135M base + LW7c benchmark
# 用法: set -a && source configs/lwv4_baseline.env && set +a
#
# 使用 **base（非 Instruct）** 模型：本实验本身做 SFT 微调，无需 chat 对齐版本。
# 显存说明：训练峰值 ≈ 权重(小) + 激活(batch×seq×层数) + 词表 logits(batch×seq×vocab)。
#
# 前置:
#   python scripts/DataProcessScripts/build_lw7c_benchmark.py
#   bash scripts/RunScripts/LWv4/download_lw_model_modelscope.sh

# 与 Llama-8B 同父目录 (/data/yaominghao/gb/models/)
# 备选（更大 base）: MODELSCOPE_ID=Qwen/Qwen2.5-0.5B  MODEL_PATH=.../Qwen2.5-0.5B
MODEL_PATH=/data/yaominghao/gb/models/SmolLM2-135M
# https://www.modelscope.cn/models/HuggingFaceTB/SmolLM2-135M
MODELSCOPE_ID=HuggingFaceTB/SmolLM2-135M
BENCHMARK_DIR=data/domain_benchmark_LW7c/seed_42

CUDA_DEVICES=0
ROUNDS=1
LOCAL_EPOCHS=1
LR=2e-4
LORA_R=8
LORA_ALPHA=16
LORA_DROPOUT=0.05
# 135M + GC：单卡 4–6GB 量级；若仍 OOM 可改为 BATCH_SIZE=1 MAX_SEQ_LENGTH=128
BATCH_SIZE=2
MAX_SEQ_LENGTH=256
GRADIENT_CHECKPOINTING=1
TORCH_DTYPE=bfloat16
TARGET_MODULES=q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj
TRUST_REMOTE_CODE=0

# 所有 LW 产物带 LW 标签
CLIENT_STATE_DIR=artifacts_LW7c/v4_client_states
METRICS_OUTPUT_DIR=artifacts_LW7c/v4_sft_metrics
LOG_DIR=log_LWv4
LOG_FILENAME_PREFIX=LWv4_sft
TRAINED_MODELS_ROOT=../trained_models_LW
V4_MIX_SAVE_ROOT=artifacts_LW7c/v4_mix_a_local

EVAL_MAX_BATCHES=10
EVAL_SEEDS=42

ONESHOT_ANCHOR_LAMBDA=1e-4
ONESHOT_PROX_LAMBDA=0.0
ONESHOT_CONSENSUS_POWER=2.0
ONESHOT_IMPORTANCE_POWER=1.0
ONESHOT_IMPORTANCE_CLIP=5.0
ONESHOT_CONFLICT_THRESHOLD=0.35
ONESHOT_CONFLICT_BLEND=1.0
ONESHOT_SCALE_CLIP_RATIO=0.0
