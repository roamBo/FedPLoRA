# FedPLoRA v4 实验默认环境（与 v2/v3 并列，见 FedPLoRAOSv4_README.md）
# 仓库根：set -a && source configs/v4_baseline.env && set +a
#
# GPU：run_v4_*.sh 第一个参数可覆盖，例如 bash scripts/RunScripts/run_v4_branch_a.sh 0

MODEL_PATH=/data/yaominghao/gb/models/Meta-Llama-3.1-8B
BENCHMARK_DIR=data/domain_benchmark_35c/seed_42
# 可被 run_v4_*.sh 的第一个参数覆盖
CUDA_DEVICES=0,1
ROUNDS=1
LOCAL_EPOCHS=1
LR=2e-4
LORA_R=8
LORA_ALPHA=16
LORA_DROPOUT=0.05
BATCH_SIZE=2
MAX_SEQ_LENGTH=2048
# 与 §11.1 一致；8B @ 2048 单卡训练必须开（v4 脚本也会传 --gradient_checkpointing）
GRADIENT_CHECKPOINTING=1
TORCH_DTYPE=bfloat16
TARGET_MODULES=q_proj,k_proj,v_proj,o_proj,up_proj,down_proj,gate_proj
CLIENT_STATE_DIR=artifacts_35c/v4_client_states
METRICS_OUTPUT_DIR=artifacts_35c/v4_sft_metrics
TRUST_REMOTE_CODE=0
SAVE_CLIENT_STATE_TO_DISK=1

# v4 eval：pilot 用 50 batch + 单 seed；定稿前再 export EVAL_MAX_BATCHES=200 EVAL_SEEDS=42,1234,9999
EVAL_MAX_BATCHES=50
EVAL_SEEDS=42

# v2-style local regularizers (kept stable across branches)
ONESHOT_ANCHOR_LAMBDA=1e-4
ONESHOT_PROX_LAMBDA=0.0
ONESHOT_CONSENSUS_POWER=2.0
ONESHOT_IMPORTANCE_POWER=1.0
ONESHOT_IMPORTANCE_CLIP=5.0
ONESHOT_CONFLICT_THRESHOLD=0.35
ONESHOT_CONFLICT_BLEND=1.0
ONESHOT_SCALE_CLIP_RATIO=0.0
YOCO_SPARSE_LAMBDA=0
